# API Server
NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://scrapeforge:localdev123@localhost:5433/scrapeforge
LOG_LEVEL=info

# Worker
WORKER_TYPE=browser
WORKER_CONCURRENCY=5
MAX_BROWSER_CONTEXTS=5
# Fetched pages are kept this many seconds (gzip, per tenant and credentials) so a request for the same
# page with another schema or other formats skips the fetch. 0 turns it off. Default 300.
# SNAPSHOT_TTL_SEC=300
# 0 turns off coalescing of identical requests in flight (they then each do the work). Default on.
# COALESCE_REQUESTS=1
# Fetches in flight per site across all workers (www. shares the budget). 0 = no limit. Default 6.
# FETCH_DOMAIN_CONCURRENCY=6
# Model calls in flight per worker process. 0 = no limit. Default 16.
# EXTRACT_LLM_CONCURRENCY=16
# A crashed worker's jobs restart about this long after the crash (BullMQ job lock). Default 30000.
# BULLMQ_LOCK_DURATION_MS=30000

# Proxy Providers
IPROYAL_API_KEY=
WEBSHARE_API_KEY=
DATAIMPULSE_API_KEY=

# AI Extraction (structured-extraction engine, see docs/engine/DESIGN.md)
# Model keys, priority order: first is primary, the rest bounded fallbacks.
# Benchmarked default (tests/eval/README.md): Gemini 2.5 Flash-Lite primary, Claude Haiku 5.5 fallback.
EXTRACT_MODELS=openrouter:google/gemini-2.5-flash-lite,openrouter:anthropic/claude-haiku-5.5
# Optional JSON capability overrides per model key, e.g. {"openrouter:x/y":{"contextTokens":128000,"maxOutputTokens":8192}}
EXTRACT_MODEL_CAPS=
# Upper bound on model spend per request in USD (requests may ask for less via maxLlmCostUsd). Default 0.05.
EXTRACT_MAX_COST_USD=0.05
# Per model call timeout in ms (the request deadline still applies). Unset = 60000.
# EXTRACT_LLM_TIMEOUT_MS=60000
# Chunk calls in flight for a listing too large for one call (1-16). Default 4.
# EXTRACT_PARTITION_CONCURRENCY=4
# 1 = ask the model for a recipe when deterministic induction fails (one extra model call). Default off.
EXTRACT_RECIPE_PROPOSE=0
# Provider keys: only the providers named in EXTRACT_MODELS need one. Never commit real values.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# The key previously committed here is leaked and must be rotated by its owner.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Outbound guard: 1 lets fetches and webhooks reach private/loopback addresses. Local development only, never in production.
SCRAPEFORGE_ALLOW_PRIVATE_NETWORK=

# CAPTCHA Solving
CAPSOLVER_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx

# Dashboard
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://app.scrapeforge.io
