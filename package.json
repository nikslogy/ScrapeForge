{
  "name": "scrapeforge",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run build -w packages/shared && npm run dev -w apps/api",
    "dev:worker": "npm run build -w packages/shared && npm run dev -w apps/worker",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed": "tsx infra/scripts/seed.ts",
    "test:integration": "vitest run tests/integration",
    "test:perf": "tsx tests/perf/percentiles.ts",
    "test:bench": "tsx tests/bench/real-world.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
